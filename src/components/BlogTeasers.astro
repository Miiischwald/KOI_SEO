---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .sort((a, b) => {
    const dateA = a.data.publishDate ? new Date(a.data.publishDate) : 0;
    const dateB = b.data.publishDate ? new Date(b.data.publishDate) : 0;
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, 3);
---

<section class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <h2 class="text-2xl font-bold tracking-tight">Aktuelle Beiträge</h2>
    <a href="/blog/" class="text-sm hover:underline">Alle Beiträge ansehen</a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    {posts.map((post) => (
      <a
        href={`/blog/${post.slug}/`}
        class="rounded-2xl border border-default bg-offset p-5 transition hover:border-secondary hover:text-secondary"
      >
        <p class="text-xs uppercase tracking-wide text-secondary">
          {post.data.publishDate
            ? new Date(post.data.publishDate).toLocaleDateString("de-DE", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : "Blog"}
        </p>
        <h3 class="text-base font-semibold">{post.data.title}</h3>
        <p class="mt-2 text-sm text-offset">{post.data.excerpt}</p>
      </a>
    ))}
  </div>
</section>
