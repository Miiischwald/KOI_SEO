---
type Cta = {
  label: string;
  href: string;
};

type Props = {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  ctaPrimary: Cta;
  ctaSecondary?: Cta;
};

const { eyebrow, headline, subheadline, ctaPrimary, ctaSecondary } = Astro.props;
const hasEyebrowSlot = Astro.slots.has("eyebrow");

const videoWebmSrc = "/media/hero/hero-loop-01.webm";
const videoMp4Src = "/media/hero/hero-loop-01.mp4";
const posterSrc = "/media/hero/hero-loop-01-poster.jpg";
---

<section class="relative left-1/2 min-h-[100svh] w-screen -translate-x-1/2 overflow-hidden border-y border-default bg-offset">
  <div class="absolute inset-0 bg-[rgba(25,71,78,0.35)]"></div>
  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/45 to-black/80"></div>

  <div class="relative z-10 mx-auto flex min-h-[100svh] max-w-6xl px-8 pb-16 pt-24">
    <div class="grid w-full items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="space-y-6">
        {hasEyebrowSlot ? (
          <div class="space-y-1 text-sm text-offset">
            <slot name="eyebrow" />
          </div>
        ) : eyebrow ? (
          <p class="text-sm text-offset">{eyebrow}</p>
        ) : null}

        <div class="space-y-3">
          <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{headline}</h1>
          {subheadline ? (
            <p class="max-w-2xl text-base text-offset sm:text-lg">
              {subheadline}
            </p>
          ) : null}
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={ctaPrimary.href}
            class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:opacity-95"
          >
            {ctaPrimary.label}
          </a>
          {ctaSecondary ? (
            <a
              href={ctaSecondary.href}
              class="rounded-full border border-white/20 bg-black/20 px-6 py-3 text-sm font-semibold text-white hover:bg-black/30"
            >
              {ctaSecondary.label}
            </a>
          ) : null}
        </div>
      </div>

      <div class="flex justify-start lg:justify-end">
        <div class="w-full max-w-[720px] max-h-[60svh] aspect-video bg-transparent">
          <video
            class="h-full w-full object-cover motion-reduce:hidden"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={posterSrc}
          >
            <source src={videoWebmSrc} type="video/webm" />
            <source src={videoMp4Src} type="video/mp4" />
          </video>
          <img
            class="hidden h-full w-full object-cover motion-reduce:block"
            src={posterSrc}
            alt=""
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </div>
</section>
