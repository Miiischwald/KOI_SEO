---
type Cta = {
  label: string;
  href: string;
};

type Props = {
  eyebrow?: string;
  headline: string;
  subheadline?: string;
  ctaPrimary: Cta;
  ctaSecondary?: Cta;
};

const { eyebrow, headline, subheadline, ctaPrimary, ctaSecondary } = Astro.props;

const videoSrc = "/media/hero/hero-loop-01.mp4";
const posterSrc = "/media/hero/hero-loop-01-poster.jpg";
---

<section class="relative overflow-hidden rounded-3xl border border-default bg-offset">
  <div class="absolute inset-0">
    <video
      class="h-full w-full object-cover motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={posterSrc}
    >
      <source src={videoSrc} type="video/mp4" />
    </video>
    <img
      class="hidden h-full w-full object-cover motion-reduce:block"
      src={posterSrc}
      alt=""
      loading="eager"
      decoding="async"
    />
  </div>

  <div class="absolute inset-0 bg-[rgba(25,71,78,0.35)]"></div>
  <div
    class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/45 to-black/80"
  ></div>

  <div class="relative px-8 py-14 sm:py-16">
    <div class="mx-auto flex max-w-4xl flex-col gap-6">
      <div class="space-y-3">
        {eyebrow ? <p class="text-sm text-offset">{eyebrow}</p> : null}
        <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{headline}</h1>
        {subheadline ? (
          <p class="max-w-3xl text-base text-offset sm:text-lg">{subheadline}</p>
        ) : null}
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href={ctaPrimary.href}
          class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:opacity-95"
        >
          {ctaPrimary.label}
        </a>
        {ctaSecondary ? (
          <a
            href={ctaSecondary.href}
            class="rounded-full border border-white/20 bg-black/20 px-6 py-3 text-sm font-semibold text-white hover:bg-black/30"
          >
            {ctaSecondary.label}
          </a>
        ) : null}
      </div>
    </div>
  </div>
</section>
