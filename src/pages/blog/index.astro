---
import KoiLayout from "~/layouts/KoiLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => {
  const dateA = a.data.publishDate ? new Date(a.data.publishDate) : 0;
  const dateB = b.data.publishDate ? new Date(b.data.publishDate) : 0;
  return dateB.getTime() - dateA.getTime();
});
---

<KoiLayout title="Blog – KOI Brandenburg">
  <section class="space-y-6">
    <div class="space-y-2">
      <p class="text-xs uppercase tracking-wide text-secondary">Blog</p>
      <h1 class="text-3xl font-bold tracking-tight">Aktuelle Beiträge</h1>
      <p class="text-sm text-offset">
        Drei erste Stub-Artikel, die bald durch vollständige Inhalte ersetzt werden.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-3">
      {posts.map((post) => (
        <a
          href={`/blog/${post.slug}/`}
          class="min-w-0 rounded-2xl border border-default bg-offset p-5 transition hover:border-secondary hover:text-secondary"
        >
          <p class="text-xs uppercase tracking-wide text-secondary">
            {post.data.publishDate
              ? new Date(post.data.publishDate).toLocaleDateString("de-DE", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : "Blog"}
          </p>
          <h2 class="text-lg font-semibold hyphens-auto break-words text-balance">{post.data.title}</h2>
          <p class="mt-2 text-sm text-offset">{post.data.excerpt}</p>
        </a>
      ))}
    </div>
  </section>
</KoiLayout>
