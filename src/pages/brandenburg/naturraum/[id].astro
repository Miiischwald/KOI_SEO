---
import { readFile } from "node:fs/promises";
import { existsSync } from "node:fs";
import { join } from "node:path";
import laproList from "~/data/lapro/brandenburg_lapro_naturraeume.v1.json";
import KoiLayout from "~/layouts/KoiLayout.astro";

export async function getStaticPaths() {
  return laproList.map((x) => ({ params: { id: x.lapro_id } }));
}

const { id } = Astro.params;
if (!id) {
  throw new Error("Missing route param: id");
}

const lapro = laproList.find((x) => x.lapro_id === id);
if (!lapro) {
  throw new Error(
    `Unknown lapro_id "${id}". Expected one of: ${laproList.map((x) => x.lapro_id).join(", ")}`,
  );
}

const expectedDataPath = join(
  process.cwd(),
  "src",
  "data",
  "naturraeume",
  `${id}.json`,
);

let naturraumData: any;
try {
  const raw = await readFile(expectedDataPath, "utf-8");
  naturraumData = JSON.parse(raw);
} catch (err) {
  throw new Error(
    `Missing or invalid page-data JSON for lapro_id "${id}". Expected file: ${expectedDataPath}`,
    { cause: err },
  );
}

if (naturraumData?.naturraum_id !== id) {
  throw new Error(
    `naturraum_id mismatch for "${id}". Found "${naturraumData?.naturraum_id}" in ${expectedDataPath}`,
  );
}

if (naturraumData?.name !== lapro.lapro_name) {
  throw new Error(
    `name mismatch for "${id}". Expected "${lapro.lapro_name}", found "${naturraumData?.name}" in ${expectedDataPath}`,
  );
}

const description = naturraumData?.seo?.meta_description ?? "";

const publicAssetsPath = join(process.cwd(), "public", "assets");
const hasPageHeroVideo = existsSync(
  join(publicAssetsPath, "naturraeume", id, "hero.mp4"),
);
const heroVideoSrc = hasPageHeroVideo
  ? `/assets/naturraeume/${id}/hero.mp4`
  : "/assets/brand/hero/loops/hero-loop-01.mp4";

const hasPageHeroPoster = existsSync(
  join(publicAssetsPath, "naturraeume", id, "hero.jpg"),
);
const heroPosterSrc = hasPageHeroPoster
  ? `/assets/naturraeume/${id}/hero.jpg`
  : "/assets/brand/hero/hero.jpg";
---

<KoiLayout
  title={naturraumData?.seo?.meta_title ?? naturraumData?.name ?? "Naturraum"}
  description={description}
>
  <div class="space-y-14">
    <nav class="text-sm text-offset">
      <a href="/brandenburg/" class="hover:underline">← Zur Brandenburg-Übersicht</a>
    </nav>

    <header class="relative overflow-hidden rounded-3xl border border-default bg-offset">
      <div class="absolute inset-0">
        <video
          class="h-full w-full object-cover"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster={heroPosterSrc}
        >
          <source src={heroVideoSrc} type="video/mp4" />
        </video>
      </div>
      <div class="absolute inset-0 bg-[rgba(25,71,78,0.35)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.05),rgba(0,0,0,0.75))]"></div>

      <div class="relative space-y-5 px-8 py-14">
        <p class="text-sm text-offset">
          Naturraum-ID: <code class="rounded bg-black/30 px-1 py-0.5">{id}</code>
        </p>
        <div class="space-y-2">
          <h1 class="text-4xl font-bold tracking-tight">
            {naturraumData.hero?.headline ?? naturraumData.name}
          </h1>
          <p class="max-w-3xl text-offset">
            {naturraumData.hero?.subheadline ??
              "Wir unterstützen bei der Einordnung, Vorbereitung und Umsetzung von Kompensationsmaßnahmen – von der Flächenprüfung bis zur Unterlagenlage."}
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={naturraumData.hero?.cta_primaer?.href ?? "/kontakt/"}
            class="rounded-full bg-primary px-6 py-3 text-sm font-semibold text-white hover:opacity-95"
          >
            {naturraumData.hero?.cta_primaer?.label ?? "Projekt anfragen"}
          </a>
          <a
            href={naturraumData.hero?.cta_sekundaer?.href ?? "/brandenburg/"}
            class="rounded-full border border-default bg-black/20 px-6 py-3 text-sm font-semibold hover:bg-black/30"
          >
            {naturraumData.hero?.cta_sekundaer?.label ?? "Zur Brandenburg-Übersicht"}
          </a>
        </div>
      </div>
    </header>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold tracking-tight">Leistungsbausteine</h2>
      <div class="grid gap-4 md:grid-cols-2">
        {naturraumData.features?.map((f) => (
          <div class="rounded-2xl border border-default bg-offset p-5">
            <h3 class="text-lg font-semibold">{f.titel}</h3>
            <p class="mt-2 text-sm text-offset">{f.beschreibung}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-6">
      <h2 class="text-2xl font-bold tracking-tight">
        Typische Kompensationsmaßnahmen
      </h2>
      <div class="grid gap-6 md:grid-cols-3">
        {naturraumData.projekte?.map((p) => (
          <article class="rounded-2xl border border-default bg-offset p-5">
            <img
              src={p.bild?.src}
              alt={p.bild?.alt ?? ""}
              class="mb-4 aspect-[4/3] w-full rounded-xl bg-black/20 object-cover"
              loading="lazy"
            />
            <h3 class="text-lg font-semibold">{p.titel}</h3>
            <p class="mt-2 text-sm text-offset">{p.beschreibung}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="space-y-3 rounded-2xl border border-default bg-offset p-5">
      <h2 class="text-lg font-semibold">Teilräume (LaPro/Scholz)</h2>
      <p class="text-sm text-offset">
        {lapro.children?.map((c) => c.scholz_name).join(", ")}
      </p>
    </section>

    <section class="space-y-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-2xl font-bold tracking-tight">
          Aktuelle Beiträge aus dem Blog
        </h2>
        <a href="/blog/" class="text-sm hover:underline">Alle Beiträge ansehen</a>
      </div>
      <div class="grid gap-4 md:grid-cols-3">
        <a href="/blog/" class="rounded-2xl border border-default bg-offset p-5">
          <h3 class="text-base font-semibold">Ökopunkte: Von der Idee zur Maßnahme</h3>
          <p class="mt-2 text-sm text-offset">
            Ein Überblick über typische Schritte, Unterlagen und Fallstricke –
            ohne unnötige Annahmen zu lokalen Details.
          </p>
        </a>
        <a href="/blog/" class="rounded-2xl border border-default bg-offset p-5">
          <h3 class="text-base font-semibold">Flächenscouting & Sicherung</h3>
          <p class="mt-2 text-sm text-offset">
            Wie wir Verfügbarkeit, Nutzbarkeit und langfristige Pflege-/Monitoring-Aspekte
            strukturiert betrachten.
          </p>
        </a>
        <a href="/blog/" class="rounded-2xl border border-default bg-offset p-5">
          <h3 class="text-base font-semibold">Behördenfähig planen</h3>
          <p class="mt-2 text-sm text-offset">
            Welche Nachweise und Beschreibungen in der Praxis helfen können, damit
            Kompensation sauber dokumentiert wird.
          </p>
        </a>
      </div>
    </section>
  </div>
</KoiLayout>
