---
import "@fontsource-variable/inter";
import Footer from "~/components/footer.astro";
import Header from "~/components/header.astro";
import laproList from "~/data/lapro/brandenburg_lapro_naturraeume.v1.json";
import "~/styles/index.css";

const { generator } = Astro;
const description =
  "Übersicht der 14 LaPro-Naturräume in Brandenburg – als Einstieg zu Ausgleichsflächen, Ökopunkten und Kompensation.";
---

<!doctype html>
<html lang="de" class="h-full motion-safe:scroll-smooth" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={generator} />

    <title>Brandenburg – Naturräume</title>
    <meta name="description" content={description} />

    <!-- initialize theme -->
    <script is:inline>
      const themeSaved = localStorage.getItem("theme");

      if (themeSaved) {
        document.documentElement.dataset.theme = themeSaved;
      } else {
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)",
        ).matches;
        document.documentElement.dataset.theme = prefersDark ? "dark" : "light";
      }

      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", (event) => {
          if (!localStorage.getItem("theme")) {
            document.documentElement.dataset.theme = event.matches
              ? "dark"
              : "light";
          }
        });
    </script>
  </head>
  <body
    class="h-full overflow-x-hidden bg-default text-default text-base selection:bg-secondary selection:text-white"
  >
    <Header />
    <main class="mx-auto max-w-5xl space-y-10 px-8 py-24">
      <header class="space-y-3">
        <h1 class="text-3xl font-bold tracking-tight">Brandenburg – Naturräume</h1>
        <p class="max-w-3xl text-secondary">
          Diese Übersicht wird ausschließlich aus der LaPro-Quelle erzeugt und
          verlinkt auf die 14 Naturraum-Seiten unter
          <code class="rounded bg-muted px-1 py-0.5">/brandenburg/naturraum/&lt;lapro_id&gt;/</code>.
        </p>
      </header>

      <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {laproList.map((item) => (
          <a
            href={`/brandenburg/naturraum/${item.lapro_id}/`}
            class="group rounded-2xl border border-default bg-muted/30 p-5 transition hover:bg-muted/50"
          >
            <div class="space-y-2">
              <h2 class="text-lg font-semibold group-hover:underline">
                {item.lapro_name}
              </h2>
              <p class="text-sm text-secondary">
                Teilräume: {item.children.map((c) => c.scholz_name).join(", ")}
              </p>
            </div>
          </a>
        ))}
      </section>
    </main>
    <Footer />
  </body>
</html>

