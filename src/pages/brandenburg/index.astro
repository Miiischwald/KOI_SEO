---
import HeroVideo from "~/components/HeroVideo.astro";
import KoiLayout from "~/layouts/KoiLayout.astro";
import SeoHead from "~/components/SeoHead.astro";
import laproList from "~/data/lapro/brandenburg_lapro_naturraeume.v1.json";

const description =
  "Übersicht der 14 LaPro-Naturräume in Brandenburg – als Einstieg zu Ausgleichsflächen, Ökopunkten und Kompensation.";
const title = "Brandenburg – Naturräume";
const canonicalUrl = new URL("/brandenburg/", Astro.site);

const heroCtaPrimary = { label: "Projekt anfragen", href: "/kontakt/" };
const heroCtaSecondary = {
  label: "Zur Brandenburg-Übersicht",
  href: "/brandenburg/",
};
---

<KoiLayout title={title} description={description}>
  <SeoHead
    slot="head"
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
  />
  <div class="-mt-16 space-y-10">
    <HeroVideo
      eyebrow="KOI_SEO • Brandenburg"
      headline="Brandenburg – Naturräume"
      subheadline={description}
      ctaPrimary={heroCtaPrimary}
      ctaSecondary={heroCtaSecondary}
    />

    <p class="max-w-3xl text-sm text-offset">
      Diese Übersicht wird ausschließlich aus der LaPro-Quelle erzeugt und
      verlinkt auf die 14 Naturraum-Seiten unter{" "}
      <code class="rounded bg-offset px-1 py-0.5">
        /brandenburg/naturraum/&lt;lapro_id&gt;/
      </code>.
    </p>

    <section id="naturraeume" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {laproList.map((item) => (
        <a
          href={`/brandenburg/naturraum/${item.lapro_id}/`}
          class="group rounded-2xl border border-default bg-offset p-5 transition hover:border-secondary"
        >
          <div class="space-y-2">
            <h2 class="text-lg font-semibold group-hover:underline">
              {item.lapro_name}
            </h2>
            <p class="text-sm text-offset">
              Teilräume: {item.children.map((c) => c.scholz_name).join(", ")}
            </p>
          </div>
        </a>
      ))}
    </section>
  </div>
</KoiLayout>
